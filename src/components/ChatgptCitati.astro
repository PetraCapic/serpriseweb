---
import data from '../data/llm-leaderboard.json';
// Interaktivni dodaci istraživanja /blog/chatgpt-citati-hrvatska/. Podaci su isti kao za leaderboard
// (src/data/llm-leaderboard.json). Svaki dio se premješta na svoje mjesto u tekstu:
//   <div data-embed="citati-scatter"></div>   graf DR / broj citata
//   <div data-embed="citati-donut"></div>     vrste citiranih stranica
//   <div data-embed="citati-samoprocjena"></div>
//   <div data-embed="citati-flip"></div>      ispred tablice pretraga: pretvara je u kartice
//   <div data-embed="citati-tablica"></div>   ispred tablice domena: dodaje sortiranje i filter
// Bez JavaScripta grafovi ostaju na dnu članka (SVG), a tablice ostaju obične tablice.

interface Props { lang?: 'hr' | 'en' }
const { lang = 'hr' } = Astro.props;
const en = lang === 'en';
const { answers } = data;
const entries = data.entries.map((e) => (en ? { ...e, page: e.page_en } : e));
type Kind = 'usluzna' | 'naslovnica' | 'cjenik' | 'case' | 'lista' | 'direktorij' | 'stari-url';
const kindLabel: Record<Kind, string> = en
  ? {
      usluzna: 'Service page',
      naslovnica: 'Homepage or About us',
      cjenik: 'Price list',
      case: 'Case study',
      lista: 'Agency list',
      direktorij: 'Directory',
      'stari-url': 'Old URL',
    }
  : {
      usluzna: 'Uslužna stranica',
      naslovnica: 'Naslovnica ili O nama',
      cjenik: 'Cjenik',
      case: 'Case study',
      lista: 'Lista agencija',
      direktorij: 'Direktorij',
      'stari-url': 'Stari URL',
    };
// Tekstovi komponente (hr ostaje kao prije, en za /en/blog/chatgpt-citations-croatia/).
const t = en
  ? {
      gAgency: 'Agency page (service, price list, homepage)', gSource: 'List or directory', gCase: 'Case study',
      bothDr0: 'glarodigital.com.hr and linkgrid.hr (both DR 0)',
      dService: 'Service pages', dSource: 'Lists and directories', dCase: 'Case study', dHome: 'Homepage or About us', dPrice: 'Price list',
      scEyebrow: 'Chart · DR and citations', scTitle: 'Domain Rating does not decide who gets cited',
      scLead: `Each dot is a domain from the table. Horizontally is DR (0 to 100), vertically the number of the ${answers} answers in which it was cited.`,
      scAria: 'Scatter chart: domains with DR 0 are cited as often as Clutch with DR 91',
      scY: 'Answers with a citation',
      ptAria: (d: string, dr: number | null, c: number) => `${d}: DR ${dr}, cited in ${c} of ${answers} answers.`,
      ptTip: (dr: number | null, c: number) => `DR ${dr} · ${c} of ${answers} answers`,
      scNote: 'Measured on 30 October 2026. DR from Ahrefs. Shown are the domains from the table (cited at least 4 times) and tako.hr; the other cited domains have fewer citations. SERPRise is not shown because we have no DR for the old URL.',
      doEyebrow: 'Chart · page types', doTitle: 'What ChatGPT cites when someone looks for an agency',
      doLead: (n: number) => `Total citations of the ${n} most frequently cited domains, by the type of page cited.`,
      doAria: (tot: number, parts: string) => `Of ${tot} citations: ${parts}, blog posts 0.`,
      doTip: (v: number, tot: number, pct: number) => `${v} of ${tot} citations (${pct}%)`,
      pct: (n: number) => `${n}%`,
      blogPosts: 'blog posts', blogPostsCap: 'Blog posts',
      doNote: (tot: number) => `${tot} citations in total: one domain can be cited in several answers. Measured on 30 October 2026.`,
      seEyebrow: 'Self-assessment · 1 minute', seTitle: 'Does your service page have the 5 things ChatGPT cites?',
      seLead: 'Open your main service page and tick what is already on it.',
      seVerdict0: 'Tick what your page has.', seCta: 'Would you like us to check it for you?', seHref: '/en/contact/',
    }
  : {
      gAgency: 'Stranica agencije (usluga, cjenik, naslovnica)', gSource: 'Lista ili direktorij', gCase: 'Case study',
      bothDr0: 'glarodigital.com.hr i linkgrid.hr (oba DR 0)',
      dService: 'Uslužne stranice', dSource: 'Liste i direktoriji', dCase: 'Case study', dHome: 'Naslovnica ili O nama', dPrice: 'Cjenik',
      scEyebrow: 'Graf · DR i citati', scTitle: 'Domain Rating ne određuje tko je citiran',
      scLead: `Svaka točka je domena iz tablice. Vodoravno je DR (0 do 100), okomito broj od ${answers} odgovora u kojima je citirana.`,
      scAria: 'Raspršeni graf: domene s DR 0 citirane su jednako često kao Clutch s DR 91',
      scY: 'Odgovora s citatom',
      ptAria: (d: string, dr: number | null, c: number) => `${d}: DR ${dr}, citirana u ${c} od ${answers} odgovora.`,
      ptTip: (dr: number | null, c: number) => `DR ${String(dr).replace('.', ',')} · ${c} od ${answers} odgovora`,
      scNote: 'Mjereno 30. listopada 2026. DR iz Ahrefsa. Prikazane su domene iz tablice (citirane barem 4 puta) i tako.hr; ostale citirane domene imaju manje citata. SERPRise nije prikazan jer za stari URL nemamo DR.',
      doEyebrow: 'Graf · vrste stranica', doTitle: 'Što ChatGPT citira kad netko traži agenciju',
      doLead: (n: number) => `Zbroj citata ${n} najčešće citiranih domena, po vrsti stranice koja je citirana.`,
      doAria: (tot: number, parts: string) => `Od ${tot} citata: ${parts}, blog članci 0.`,
      doTip: (v: number, tot: number, pct: number) => `${v} od ${tot} citata (${pct} %)`,
      pct: (n: number) => `${n} %`,
      blogPosts: 'blog članaka', blogPostsCap: 'Blog članci',
      doNote: (tot: number) => `Ukupno ${tot} citata: jedna domena može biti citirana u više odgovora. Mjereno 30. listopada 2026.`,
      seEyebrow: 'Samoprocjena · 1 minuta', seTitle: 'Ima li vaša uslužna stranica 5 stvari koje ChatGPT citira?',
      seLead: 'Otvorite svoju glavnu uslužnu stranicu i označite što na njoj već postoji.',
      seVerdict0: 'Označite što vaša stranica ima.', seCta: 'Želite da provjerimo umjesto vas?', seHref: '/kontakt/?usluga=ai-vidljivost',
    };
// Tekstovi za klijentsku skriptu; za hrvatski se atribut ne ispisuje (skripta ima hrvatske zadane vrijednosti).
const clientText = en
  ? JSON.stringify({
      verdict5: 'Your page has everything we saw on the cited pages. The next step is mentions outside your website: lists, directories and news sites.',
      verdict3: 'A good foundation. For every empty box, the next step is:',
      verdict0: 'ChatGPT will struggle to use a page like this as a source. Start from the top:',
      flipHint: 'Click a card to see what ChatGPT actually searched.',
      flipFront: 'Question in Croatian',
      flipBack: 'ChatGPT searched',
      colCites: 'answers', colDr: 'dr', colKind: 'page type',
      kindLabel: 'Page type', all: 'All',
      count: '{n} of {total} domains',
    })
  : undefined;

// Scatter: tri skupine (više boja u raspršenom grafu nije čitljivo), točna vrsta je u oznaci i tooltipu.
const group = (k: Kind) => (k === 'lista' || k === 'direktorij' ? 'izvor' : k === 'case' ? 'case' : 'agencija');
const groups = [
  { id: 'agencija', label: t.gAgency, color: 'var(--c1)' },
  { id: 'izvor', label: t.gSource, color: 'var(--c2)' },
  { id: 'case', label: t.gCase, color: 'var(--c3)' },
];
const W = 640, H = 340, L = 44, R = 24, T = 16, B = 46;
const yMax = 7;
const x = (dr: number) => L + (dr / 100) * (W - L - R);
const y = (c: number) => H - B - (c / yMax) * (H - T - B);
// Ručni položaj oznaka da se ne preklapaju (dx, dy, poravnanje).
const labelPos: Record<string, [number, number, 'start' | 'end']> = {
  'glarodigital.com.hr': [10, -12, 'start'],
  'linkgrid.hr': [0, 0, 'start'],
  'digitalmatrix.hr': [-4, 22, 'start'],
  'assemblio.hr': [-10, -13, 'start'],
  'tsunami-digital.com': [-6, 22, 'start'],
  'igrow.at': [8, -11, 'start'],
  'clutch.co': [-12, 4, 'end'],
};
const pts = entries
  .filter((e) => e.dr !== null)
  .map((e) => {
    const same = entries.filter((o) => o.dr === e.dr && o.cites === e.cites && o.dr !== null);
    // Domene s istim DR-om i brojem citata malo razmaknemo vodoravno da se obje vide.
    const dodge = same.length > 1 ? (same.indexOf(e) - (same.length - 1) / 2) * 9 : 0;
    const lp = labelPos[e.domain] ?? [10, 4, 'start'];
    const label = e.domain === 'glarodigital.com.hr' ? t.bothDr0 : e.domain === 'linkgrid.hr' ? '' : e.domain;
    return { ...e, cx: x(e.dr as number) + dodge, cy: y(e.cites), g: group(e.kind as Kind), lp, label };
  });
const color = (g: string) => groups.find((x) => x.id === g)!.color;

// Donut: zbroj citata po vrsti stranice među domenama iz tablice.
const donutCats = [
  { id: 'usluzna', label: t.dService, kinds: ['usluzna'], color: 'var(--c1)' },
  { id: 'izvor', label: t.dSource, kinds: ['lista', 'direktorij'], color: 'var(--c2)' },
  { id: 'case', label: t.dCase, kinds: ['case'], color: 'var(--c3)' },
  { id: 'naslovnica', label: t.dHome, kinds: ['naslovnica'], color: 'var(--c4)' },
  { id: 'cjenik', label: t.dPrice, kinds: ['cjenik'], color: 'var(--c5)' },
].map((c) => {
  const items = entries.filter((e) => c.kinds.includes(e.kind));
  return { ...c, value: items.reduce((s, e) => s + e.cites, 0), domains: items.map((e) => e.domain) };
});
const total = donutCats.reduce((s, c) => s + c.value, 0);
const nDomains = entries.filter((e) => e.kind !== 'stari-url').length;
const Rd = 70, C = 2 * Math.PI * Rd, gap = 3;
let acc = 0;
const arcs = donutCats.map((c) => {
  const len = (c.value / total) * C;
  const a = { ...c, dash: `${Math.max(len - gap, 0)} ${C}`, offset: -acc, pct: Math.round((c.value / total) * 100) };
  acc += len;
  return a;
});

const checks = en ? [
  { t: 'The service name in the page title, in the same words the customer asks with', next: 'Change the H1 and title to the words from the customer\'s question, e.g. "SEO agency Zagreb" instead of "Our services".' },
  { t: 'Prices in euros, at least starting prices', next: 'Add a "Starting prices" section with at least one amount in euros. Without it, ChatGPT cites someone else\'s price list for a question about price.' },
  { t: 'A short answer at the top (2 to 3 sentences)', next: 'Put a "Summary" block at the top: what you do, for whom and from how many euros. The template is in the article below.' },
  { t: 'An FAQ with FAQPage schema and Service schema with a price', next: 'Add 4 to 6 questions your customers actually ask, with FAQPage schema, and Service schema with an Offer price (example code is in the article).' },
  { t: 'Numbers from a real project', next: 'Add one concrete client result with a number and a timeframe, e.g. "from page 2 to page 1 in 3 months".' },
] : [
  { t: 'Naziv usluge u naslovu stranice, istim riječima kojima kupac pita', next: 'Promijenite H1 i title u riječi iz pitanja kupca, npr. "SEO agencija Zagreb" umjesto "Naše usluge".' },
  { t: 'Cijene u eurima, barem početne', next: 'Dodajte sekciju "Početne cijene" s barem jednim iznosom u eurima. Bez nje ChatGPT za pitanje o cijeni citira tuđi cjenik.' },
  { t: 'Kratak odgovor na vrhu (2 do 3 rečenice)', next: 'Na vrh stavite blok "Ukratko": što radite, za koga i od koliko eura. Predložak je u članku ispod.' },
  { t: 'FAQ s FAQPage schemom i Service schema s cijenom', next: 'Dodajte 4 do 6 pitanja koja kupci stvarno postavljaju, s FAQPage schemom, i Service schemu s Offer cijenom (primjer koda je u članku).' },
  { t: 'Brojke iz stvarnog projekta', next: 'Dodajte jedan konkretan rezultat klijenta s brojkom i rokom, npr. "s 2. stranice na 1. za 3 mjeseca".' },
];
---
<div class="cc" data-cc data-i18n={clientText} hidden>
  <figure class="cc__card" data-citati="scatter" aria-labelledby="cc-sc-t">
    <p class="cc__eyebrow">{t.scEyebrow}</p>
    <h3 id="cc-sc-t" class="cc__title">{t.scTitle}</h3>
    <p class="cc__lead">{t.scLead}</p>
    <ul class="cc__legend">
      {groups.map((g) => <li><span style={`background:${g.color}`}></span>{g.label}</li>)}
    </ul>
    <div class="cc__plot">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.scAria}>
        {[0, 1, 2, 3, 4, 5, 6, 7].map((c) => (
          <g>
            <line x1={L} x2={W - R} y1={y(c)} y2={y(c)} class={c === 0 ? 'cc__axis' : 'cc__grid'} />
            <text x={L - 10} y={y(c) + 4} text-anchor="end" class="cc__tick">{c}</text>
          </g>
        ))}
        {[0, 20, 40, 60, 80, 100].map((d) => <text x={x(d)} y={H - B + 18} text-anchor="middle" class="cc__tick">{d}</text>)}
        <text x={(L + W - R) / 2} y={H - 6} text-anchor="middle" class="cc__axislabel">Domain Rating (Ahrefs)</text>
        <text x={12} y={T + 4} class="cc__axislabel" transform={`rotate(-90 12 ${T + 4})`} text-anchor="end">{t.scY}</text>
        {pts.map((p) => (
          <g class="cc__pt" tabindex="0" role="img" aria-label={`${t.ptAria(p.domain, p.dr, p.cites)} ${p.page}.`}
            data-tip={`<strong>${p.domain}</strong><br>${t.ptTip(p.dr, p.cites)}<br>${kindLabel[p.kind as Kind]}: ${p.page}`}>
            <circle cx={p.cx} cy={p.cy} r="16" class="cc__hit" />
            <circle cx={p.cx} cy={p.cy} r="6.5" fill={color(p.g)} class="cc__dot" />
            {p.label && <text x={p.cx + p.lp[0]} y={p.cy + p.lp[1]} text-anchor={p.lp[2]} class="cc__lbl">{p.label}</text>}
          </g>
        ))}
      </svg>
      <div class="cc__tip" role="status" hidden></div>
    </div>
    <figcaption class="cc__note">{t.scNote}</figcaption>
  </figure>

  <figure class="cc__card" data-citati="donut" aria-labelledby="cc-do-t">
    <p class="cc__eyebrow">{t.doEyebrow}</p>
    <h3 id="cc-do-t" class="cc__title">{t.doTitle}</h3>
    <p class="cc__lead">{t.doLead(nDomains)}</p>
    <div class="cc__donut">
      <svg viewBox="0 0 200 200" role="img" aria-label={t.doAria(total, arcs.map((a) => `${a.label} ${a.value}`).join(', '))}>
        <g transform="rotate(-90 100 100)">
          {arcs.map((a) => (
            <circle cx="100" cy="100" r={Rd} fill="none" stroke={a.color} stroke-width="26" stroke-dasharray={a.dash} stroke-dashoffset={a.offset} class="cc__arc" tabindex="0"
              data-tip={`<strong>${a.label}</strong><br>${t.doTip(a.value, total, a.pct)}<br>${a.domains.join(', ')}`} />
          ))}
        </g>
        <text x="100" y="96" text-anchor="middle" class="cc__big">0</text>
        <text x="100" y="118" text-anchor="middle" class="cc__small">{t.blogPosts}</text>
      </svg>
      <ul class="cc__dlegend">
        {arcs.map((a) => <li><span style={`background:${a.color}`}></span>{a.label}<b>{a.value}</b><small>{t.pct(a.pct)}</small></li>)}
        <li class="is-zero"><span></span>{t.blogPostsCap}<b>0</b><small>{t.pct(0)}</small></li>
      </ul>
      <div class="cc__tip" role="status" hidden></div>
    </div>
    <figcaption class="cc__note">{t.doNote(total)}</figcaption>
  </figure>

  <section class="cc__card cc__self" data-citati="samoprocjena" aria-labelledby="cc-se-t">
    <p class="cc__eyebrow">{t.seEyebrow}</p>
    <h3 id="cc-se-t" class="cc__title">{t.seTitle}</h3>
    <p class="cc__lead">{t.seLead}</p>
    <form class="cc__checks" onsubmit="return false">
      {checks.map((c, i) => (
        <label><input type="checkbox" data-i={i} /> <span>{c.t}</span></label>
      ))}
    </form>
    <div class="cc__result" aria-live="polite">
      <p class="cc__score"><strong data-score>0</strong> / 5</p>
      <p data-verdict>{t.seVerdict0}</p>
      <ol data-next>
        {checks.map((c, i) => <li data-i={i}>{c.next}</li>)}
      </ol>
      <a class="btn btn--primary" href={t.seHref}>{t.seCta}</a>
    </div>
  </section>
</div>

<script>
  // Hrvatski tekstovi su zadani; engleska verzija ih šalje u data-i18n.
  const hr = {
    verdict5: 'Stranica ima sve što smo vidjeli kod citiranih stranica. Sljedeći korak su spomeni izvan vašeg weba: liste, direktoriji i portali.',
    verdict3: 'Dobra osnova. Za svaki prazan kvadratić sljedeći korak je:',
    verdict0: 'ChatGPT ovakvu stranicu teško uzima kao izvor. Krenite redom:',
    flipHint: 'Kliknite karticu da vidite što je ChatGPT stvarno pretražio.',
    flipFront: 'Pitanje na hrvatskom',
    flipBack: 'ChatGPT je pretražio',
    colCites: 'odgovora', colDr: 'dr', colKind: 'vrsta',
    kindLabel: 'Vrsta stranice', all: 'Sve',
    count: '{n} od {total} domena',
  };
  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    const s: typeof hr = root.dataset.i18n ? { ...hr, ...JSON.parse(root.dataset.i18n) } : hr;
    // Premjesti grafove i samoprocjenu na mjesta u tekstu; bez mjesta ostaju na dnu.
    root.querySelectorAll<HTMLElement>('[data-citati]').forEach((el) => {
      const slot = document.querySelector(`[data-embed="citati-${el.dataset.citati}"]`);
      if (slot) slot.replaceWith(el);
    });
    root.hidden = false;

    // Tooltip za točke grafa i dijelove donuta (miš, dodir i tipkovnica).
    document.querySelectorAll<HTMLElement>('.cc__plot, .cc__donut').forEach((box) => {
      const tip = box.querySelector<HTMLElement>('.cc__tip')!;
      const show = (t: Element) => {
        const r = (t as SVGGraphicsElement).getBoundingClientRect();
        const b = box.getBoundingClientRect();
        tip.innerHTML = (t as HTMLElement).dataset.tip!;
        tip.hidden = false;
        const left = Math.min(Math.max(r.left + r.width / 2 - b.left, 90), b.width - 90);
        tip.style.left = `${left}px`;
        tip.style.top = `${r.top - b.top}px`;
      };
      box.querySelectorAll('[data-tip]').forEach((t) => {
        t.addEventListener('mouseenter', () => show(t));
        t.addEventListener('focus', () => show(t));
        t.addEventListener('click', () => show(t));
        t.addEventListener('mouseleave', () => (tip.hidden = true));
        t.addEventListener('blur', () => (tip.hidden = true));
      });
    });

    // Samoprocjena.
    const self = document.querySelector<HTMLElement>('[data-citati="samoprocjena"]');
    if (self) {
      const boxes = [...self.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
      const score = self.querySelector('[data-score]')!;
      const verdict = self.querySelector('[data-verdict]')!;
      const next = [...self.querySelectorAll<HTMLLIElement>('[data-next] li')];
      const update = () => {
        const n = boxes.filter((b) => b.checked).length;
        score.textContent = String(n);
        boxes.forEach((b, i) => (next[i].hidden = b.checked));
        verdict.textContent =
          n === 5 ? s.verdict5 : n >= 3 ? s.verdict3 : s.verdict0;
      };
      boxes.forEach((b) => b.addEventListener('change', update));
      update();
    }

    // Tablica pretraga: kartice "pitaš na hrvatskom, ChatGPT pretražuje na engleskom".
    const flipSlot = document.querySelector('[data-embed="citati-flip"]');
    const flipTable = flipSlot?.nextElementSibling;
    if (flipSlot && flipTable?.tagName === 'TABLE') {
      const rows = [...flipTable.querySelectorAll('tbody tr')].map((tr) => [...tr.children].map((td) => td.textContent!.trim()));
      const wrap = document.createElement('div');
      wrap.className = 'cc-flip';
      wrap.innerHTML =
        `<p class="cc-flip__hint">${s.flipHint}</p><div class="cc-flip__grid"></div>`;
      const grid = wrap.querySelector('.cc-flip__grid')!;
      rows.forEach(([hr, en]) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cc-flip__card';
        b.setAttribute('aria-pressed', 'false');
        b.innerHTML = `<span class="cc-flip__inner"><span class="cc-flip__face"><small>${s.flipFront}</small><span></span></span><span class="cc-flip__face cc-flip__back"><small>${s.flipBack}</small><span lang="en"></span></span></span>`;
        const faces = b.querySelectorAll('.cc-flip__face > span');
        faces[0].textContent = hr;
        faces[1].textContent = en;
        b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')));
        grid.appendChild(b);
      });
      flipSlot.replaceWith(wrap);
      flipTable.classList.add('cc-visually-hidden');
    }

    // Tablica domena: sortiranje po citatima i DR-u, filter po vrsti stranice. Tablica ostaje u HTML-u.
    const tSlot = document.querySelector('[data-embed="citati-tablica"]');
    const table = tSlot?.nextElementSibling as HTMLTableElement | null | undefined;
    if (tSlot && table?.tagName === 'TABLE') {
      const heads = [...table.querySelectorAll('thead th')].map((th) => th.textContent!.trim());
      const col = (name: string) => heads.findIndex((h) => h.toLowerCase().startsWith(name));
      const ci = col(s.colCites), di = col(s.colDr), ki = col(s.colKind);
      const tbody = table.tBodies[0];
      const rows = [...tbody.rows];
      const num = (r: HTMLTableRowElement, i: number) => Number(r.cells[i].textContent!.replace(',', '.')) || 0;
      const bar = document.createElement('div');
      bar.className = 'cc-tbar';
      const kinds = [...new Set(rows.map((r) => r.cells[ki]?.textContent!.trim()).filter(Boolean))];
      bar.innerHTML = `<label>${s.kindLabel} <select><option value="">${s.all}</option>${kinds.map((k) => `<option>${k}</option>`).join('')}</select></label><span class="cc-tbar__n"></span>`;
      tSlot.replaceWith(bar);
      const sel = bar.querySelector('select')!;
      const count = bar.querySelector('.cc-tbar__n')!;
      let sortBy = ci, dir = -1;
      const ths = table.querySelectorAll<HTMLTableCellElement>('thead th');
      [ci, di].forEach((i) => {
        const th = ths[i];
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cc-sort';
        b.textContent = th.textContent;
        th.textContent = '';
        th.appendChild(b);
        b.addEventListener('click', () => {
          dir = sortBy === i ? -dir : -1;
          sortBy = i;
          apply();
        });
      });
      const apply = () => {
        rows.sort((a, b) => dir * (num(a, sortBy) - num(b, sortBy)) || num(b, ci) - num(a, ci));
        let n = 0;
        rows.forEach((r) => {
          r.hidden = !!sel.value && r.cells[ki].textContent!.trim() !== sel.value;
          if (!r.hidden) n++;
          tbody.appendChild(r);
        });
        ths.forEach((th, i) => th.setAttribute('aria-sort', i === sortBy ? (dir < 0 ? 'descending' : 'ascending') : 'none'));
        count.textContent = s.count.replace('{n}', String(n)).replace('{total}', String(rows.length));
      };
      sel.addEventListener('change', apply);
      apply();
    }
  });
</script>

