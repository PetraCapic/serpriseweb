---
import { nav } from '../lib/site';
import { enNav, altFor } from '../lib/en';
import Logo from './Logo.astro';
import { getPosts } from '../lib/blog';
interface Props { lang?: 'hr' | 'en' }
const { lang = 'hr' } = Astro.props;
const isEn = lang === 'en';
const path = Astro.url.pathname;
const alt = altFor(path);
// Blog je u izborniku tek kad ima barem jedan objavljen članak.
const hasPosts = (await getPosts()).length > 0;
const items = isEn ? enNav : nav.filter((i) => i.href !== '/blog/' || hasPosts);
// Jezični prekidač vodi na odgovarajuću stranicu na drugom jeziku, inače na početnu.
const switchHref = isEn ? (alt?.hr ?? '/') : (alt?.en ?? '/en/');
---

<header class="header">
  <div class="container header__inner">
    <a href={isEn ? '/en/' : '/'} class="header__logo" aria-label={isEn ? 'SERPRise – home' : 'SERPRise – početna'}><Logo /></a>
    <button class="header__toggle" aria-expanded="false" aria-controls="main-nav" aria-label={isEn ? 'Menu' : 'Izbornik'}>
      <span></span><span></span><span></span>
    </button>
    <nav id="main-nav" class="header__nav" aria-label={isEn ? 'Main menu' : 'Glavni izbornik'}>
      {
        items.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={switchHref} class="header__lang" hreflang={isEn ? 'hr' : 'en'} lang={isEn ? 'hr' : 'en'} aria-label={isEn ? 'Hrvatska verzija' : 'English version'}>{isEn ? 'HR' : 'EN'}</a>
      <a href={isEn ? '/en/contact/' : '/kontakt/'} class="btn btn--primary header__cta">{isEn ? 'Free audit' : 'Besplatna analiza'}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.header__toggle');
  const navEl = document.getElementById('main-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .header__logo {
    color: var(--text);
    text-decoration: none;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .header__nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .header__nav a:not(.btn):hover,
  .header__nav a[aria-current='page'] {
    color: var(--text);
  }
  .header__lang {
    font-size: 0.8rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .header__cta {
    padding: 10px 18px;
    font-size: 0.92rem;
  }
  .header__toggle {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
  }
  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    margin: 5px 0;
  }
  @media (max-width: 900px) {
    .header__toggle {
      display: block;
    }
    .header__nav {
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px 20px 24px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      display: none;
    }
    .header__nav.is-open {
      display: flex;
    }
    .header__nav a:not(.btn) {
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
      font-size: 1.05rem;
    }
    .header__lang {
      border: 0 !important;
      border-radius: 0;
      padding: 14px 0 !important;
    }
    .header__cta {
      margin-top: 16px;
      justify-content: center;
    }
  }
</style>
