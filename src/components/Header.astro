---
import { nav, adminUrl } from '../lib/site';
import Logo from './Logo.astro';
import { getPosts } from '../lib/blog';
const path = Astro.url.pathname;
// Blog se u izborniku pojavljuje tek kad postoji barem jedan objavljeni članak.
const items = (await getPosts()).length ? [...nav.slice(0, 3), { href: '/blog/', label: 'Blog' }, ...nav.slice(3)] : nav;
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="SERPRise – početna"><Logo /></a>
    <button class="header__toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Izbornik">
      <span></span><span></span><span></span>
    </button>
    <nav id="main-nav" class="header__nav" aria-label="Glavni izbornik">
      {
        items.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={adminUrl} class="header__login" rel="nofollow">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2M3.5 7h9v7h-9z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
        Prijava
      </a>
      <a href="/kontakt/" class="btn btn--primary header__cta">Besplatna analiza</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.header__toggle');
  const navEl = document.getElementById('main-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .header__logo {
    color: var(--text);
    text-decoration: none;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .header__nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .header__nav a:not(.btn):hover,
  .header__nav a[aria-current='page'] {
    color: var(--text);
  }
  .header__login {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .header__cta {
    padding: 10px 18px;
    font-size: 0.92rem;
  }
  .header__toggle {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
  }
  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    margin: 5px 0;
  }
  @media (max-width: 900px) {
    .header__toggle {
      display: block;
    }
    .header__nav {
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px 20px 24px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      display: none;
    }
    .header__nav.is-open {
      display: flex;
    }
    .header__nav a:not(.btn) {
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
      font-size: 1.05rem;
    }
    .header__cta {
      margin-top: 16px;
      justify-content: center;
    }
  }
</style>
