---
// Animirani dijagram "Kako ChatGPT slaže odgovor": 4 koraka, pale se redom kad dijagram dođe u vidno polje.
// Bez JS-a (ili uz prefers-reduced-motion) svi koraci su odmah vidljivi. Tekstualna verzija je u članku.
// U članku: <div data-embed="answer-flow"></div>
interface Props { lang?: 'hr' | 'en' }
const { lang = 'hr' } = Astro.props;
const steps = lang === 'en'
  ? [
      { t: 'Question', d: '"Which agency in Split does SEO and how much does it cost?"', chips: [] },
      { t: 'Search (fan-out)', d: 'ChatGPT writes several searches itself, in Croatian and in English.', chips: ['seo agencija split cijena', 'SEO agency Split Croatia pricing', 'seo usluge split'] },
      { t: '~10 pages opened', d: 'It opens around ten results and reads their HTML.', chips: ['service page', 'price list', 'agency list', 'directory', 'local news site'] },
      { t: 'Answer with sources', d: 'It builds the answer from what it has read and cites its sources. If you are not among those ten, you do not exist.', chips: ['[1] yourcompany.hr', '[2] clutch.co', '[3] lista.hr'] },
    ]
  : [
  { t: 'Pitanje', d: '"Koja agencija u Splitu radi SEO i koliko košta?"', chips: [] },
  { t: 'Pretraga (fan-out)', d: 'ChatGPT sam napiše nekoliko pretraga, na hrvatskom i engleskom.', chips: ['seo agencija split cijena', 'SEO agency Split Croatia pricing', 'seo usluge split'] },
  { t: '~10 otvorenih stranica', d: 'Otvori desetak rezultata i pročita njihov HTML.', chips: ['uslužna stranica', 'cjenik', 'lista agencija', 'direktorij', 'lokalni portal'] },
  { t: 'Odgovor s izvorima', d: 'Složi odgovor iz onoga što je pročitao i navede izvore. Ako niste među tih desetak, ne postojite.', chips: ['[1] vasafirma.hr', '[2] clutch.co', '[3] lista.hr'] },
];
const t = lang === 'en'
  ? { eyebrow: 'Diagram', title: 'How ChatGPT builds an answer', replay: 'Replay animation' }
  : { eyebrow: 'Dijagram', title: 'Kako ChatGPT slaže odgovor', replay: 'Ponovi animaciju' };
---
<figure class="wg aflow" data-aflow aria-labelledby="aflow-title">
  <p class="wg__eyebrow">{t.eyebrow}</p>
  <h3 id="aflow-title" class="wg__title">{t.title}</h3>
  <ol class="aflow__steps">
    {steps.map((s, i) => (
      <li class="aflow__step" style={`--i:${i}`}>
        <span class="aflow__n">{i + 1}</span>
        <div>
          <strong>{s.t}</strong>
          <p>{s.d}</p>
          {s.chips.length > 0 && <ul class="aflow__chips">{s.chips.map((c) => <li>{c}</li>)}</ul>}
        </div>
      </li>
    ))}
  </ol>
  <button type="button" class="aflow__replay" hidden>{t.replay}</button>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-aflow]').forEach((el) => {
    const slot = document.querySelector('[data-embed="answer-flow"]');
    if (slot) slot.replaceWith(el);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const replay = el.querySelector<HTMLButtonElement>('.aflow__replay')!;
    el.classList.add('is-armed');
    const play = () => {
      el.classList.remove('is-on');
      void el.offsetWidth;
      el.classList.add('is-on');
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          play();
          replay.hidden = false;
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(el);
    replay.addEventListener('click', play);
  });
</script>

<style>
  .aflow__steps { list-style: none; margin: 18px 0 0 !important; padding: 0 !important; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; position: relative; }
  .aflow__step { margin: 0 !important; background: var(--bg-2); border-radius: 12px; padding: 16px; position: relative; display: grid; gap: 8px; align-content: start; }
  .aflow__step:not(:last-child)::after { content: '→'; position: absolute; right: -13px; top: 18px; color: var(--accent); font-weight: 700; z-index: 1; }
  .aflow__n { width: 28px; height: 28px; border-radius: 50%; background: var(--grad); color: #fff; display: grid; place-items: center; font: 700 0.85rem var(--font-display); }
  .aflow__step strong { color: var(--navy); font-family: var(--font-display); }
  .aflow__step p { margin: 4px 0 0; font-size: 0.88rem; color: var(--muted); line-height: 1.45; }
  .aflow__chips { list-style: none; margin: 8px 0 0 !important; padding: 0 !important; display: flex; flex-wrap: wrap; gap: 6px; }
  .aflow__chips li { margin: 0 !important; background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 2px 9px; font-size: 0.75rem; color: var(--navy); }
  .aflow__replay { margin-top: 12px; border: 0; background: none; color: var(--accent); font: 600 0.85rem var(--font); cursor: pointer; padding: 0; }
  /* Animacija: tek kad je JS uključen (is-armed) koraci kreću skriveni */
  .is-armed .aflow__step { opacity: 0; transform: translateY(14px); }
  .is-armed .aflow__chips li { opacity: 0; }
  .is-on .aflow__step { animation: aflow-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; animation-delay: calc(var(--i) * 0.7s); }
  .is-on .aflow__chips li { animation: aflow-fade 0.35s ease forwards; animation-delay: calc(var(--i) * 0.7s + 0.35s); }
  @keyframes aflow-in { to { opacity: 1; transform: none; } }
  @keyframes aflow-fade { to { opacity: 1; } }
  @media (max-width: 760px) {
    .aflow__steps { grid-template-columns: 1fr 1fr; }
    .aflow__step:nth-child(2)::after { display: none; }
  }
  @media (max-width: 480px) {
    .aflow__steps { grid-template-columns: 1fr; }
    .aflow__step:not(:last-child)::after { content: '↓'; right: auto; left: 50%; top: auto; bottom: -15px; display: block; }
  }
</style>
