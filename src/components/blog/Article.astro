---
import { render } from 'astro:content';
// Jedan članak bloga (hrvatski ili engleski). Rute: pages/blog/[slug].astro i pages/[...path].astro (vlastiti URL).
import Base from '../../layouts/Base.astro';
import Cta from '../Cta.astro';
import LlmLeaderboard from '../LlmLeaderboard.astro';
import ChatgptCitati from '../ChatgptCitati.astro';
import LlmTracker from './LlmTracker.astro';
import AiQuiz from './AiQuiz.astro';
import ClusterMap from './ClusterMap.astro';
import AnswerFlow from './AnswerFlow.astro';
import GlossaryTips from './GlossaryTips.astro';
import Ga4AiKanal from '../Ga4AiKanal.astro';
import AiProvjera from '../AiProvjera.astro';
import PortaliClanak from '../PortaliClanak.astro';
import { getPosts, formatDate, readingTime, postUrl } from '../../lib/blog';
import { site, team } from '../../lib/site';

const { post } = Astro.props;
const lang = post.data.lang;
const isEn = lang === 'en';
const t = isEn
  ? { crumbs: 'Breadcrumb', home: 'Home', blog: '/en/blog/', published: 'published', updated: 'Last updated', read: 'min read', faq: 'FAQ', sources: 'Sources', copy: 'Copy', copied: 'Copied', copyFail: 'Select and copy manually' }
  : { crumbs: 'Putanja', home: 'Početna', blog: '/blog/', published: 'objavljeno', updated: 'Zadnje ažurirano', read: 'min čitanja', faq: 'Česta pitanja', sources: 'Izvori', copy: 'Kopiraj', copied: 'Kopirano', copyFail: 'Označite i kopirajte ručno' };
// Isti članak na drugom jeziku (hreflang i prekidač HR/EN).
const other = post.data.translation ? (await getPosts('all')).find((p) => p.id === post.data.translation) : undefined;
const alternates = other ? (isEn ? { hr: postUrl(other), en: postUrl(post) } : { hr: postUrl(post), en: postUrl(other) }) : undefined;
const { Content } = await render(post);
const { title, description, date, updated, author, image, imageAlt, dataset, about, hasPart, faq, sources } = post.data;
const allPosts = hasPart ? await getPosts('all') : [];
const parts = (hasPart ?? []).map((slug) => allPosts.find((p) => p.id === slug)).filter((p) => p !== undefined);
const url = `${site.url}${postUrl(post)}`;
const person = team.find((m) => m.name === author);
// Interaktivni dodaci pojedinih članaka; u tekstu ih označava <div data-embed="..."></div>.
const has = (name: string) => Boolean(post.body?.includes(`data-embed="${name}"`));
const hasLeaderboard = has('leaderboard');
const hasTerms = Boolean(post.body?.includes('data-term="'));
const hasGa4 = Boolean(post.body?.includes('data-embed="ga4-'));
const { howto } = post.data;
const hasCitati = Boolean(post.body?.includes('data-embed="citati-'));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: lang,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    image: new URL(image ?? '/og.png', site.url).href,
    author: person?.profile
      ? { '@type': 'Person', '@id': `${site.url}${person.profile}#person`, name: author, url: `${site.url}${person.profile}` }
      : { '@type': 'Person', name: author, ...(person?.linkedin && { sameAs: [person.linkedin] }) },
    publisher: { '@id': `${site.url}/#organization` },
    isPartOf: { '@id': `${site.url}${t.blog}#blog` },
    ...(about && { about: about.map((a) => ({ '@type': 'Thing', ...a })) }),
    ...(parts.length && {
      hasPart: parts.map((p) => ({
        '@type': 'BlogPosting',
        '@id': `${site.url}${postUrl(p)}#article`,
        headline: p.data.title,
        url: `${site.url}${postUrl(p)}`,
      })),
    }),
    ...(sources && { citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.name, url: s.url })) }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: `${site.url}${isEn ? '/en/' : '/'}` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}${t.blog}` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
  ...(dataset
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Dataset',
          '@id': `${url}#dataset`,
          name: dataset.name,
          description: dataset.description,
          url,
          inLanguage: 'hr',
          keywords: dataset.keywords,
          license: dataset.license,
          isAccessibleForFree: true,
          datePublished: date.toISOString().slice(0, 10),
          dateModified: (updated ?? date).toISOString().slice(0, 10),
          temporalCoverage: dataset.measured.toISOString().slice(0, 10),
          spatialCoverage: { '@type': 'Place', name: 'Hrvatska' },
          measurementTechnique: dataset.method,
          creator: { '@id': `${site.url}/#organization` },
          publisher: { '@id': `${site.url}/#organization` },
          isBasedOn: `${url}#article`,
          distribution: dataset.files.map((f) => ({
            '@type': 'DataDownload',
            name: f.name,
            encodingFormat: 'text/csv',
            contentUrl: new URL(f.url, site.url).href,
          })),
        },
      ]
    : []),
  ...(faq?.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
  ...(howto
    ? [{
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: howto.name,
        inLanguage: lang,
        ...(howto.totalTime && { totalTime: howto.totalTime }),
        step: howto.steps.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text, url: `${url}#${howto.anchor ?? 'kanal-u-7-koraka'}` })),
      }]
    : []),
];
---

<Base title={title} description={description} schema={schema} ogType="article" image={image} lang={lang} alternates={alternates}>
  <article class="section">
    <div class="container prose article">
      <nav class="muted crumbs" aria-label={t.crumbs}><a href={t.blog}>Blog</a></nav>
      <h1>{title}</h1>
      <p class="muted article__meta">
        {person?.profile ? <a href={person.profile} rel="author">{author}</a> : author} · {t.published} <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>{updated && <> · <strong class="article__upd">{t.updated}: <time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time></strong></>} · {readingTime(post.body)} {t.read}
      </p>
      {image && <img src={image} alt={imageAlt ?? ''} class="article__img" />}
      <Content />
      {hasLeaderboard && <LlmLeaderboard />}
      {hasCitati && <ChatgptCitati />}
      {has('tracker') && <LlmTracker />}
      {has('quiz') && <AiQuiz />}
      {has('cluster-map') && <ClusterMap />}
      {has('answer-flow') && <AnswerFlow />}
      {hasTerms && <GlossaryTips />}
      {has('ai-generator') && <AiProvjera />}
      {post.body?.includes('data-embed="portali-') && <PortaliClanak />}
      {/* Vidljiv FAQ iz frontmattera, osim ako ga članak već ima u tekstu */}
      {faq && !post.body?.includes(`## ${t.faq}`) && (
        <section class="article__faq" id={isEn ? 'faq' : 'cesta-pitanja'}>
          <h2>{t.faq}</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}
      {sources && (
        <section class="article__sources" id={isEn ? 'sources' : 'izvori'}>
          <h2>{t.sources}</h2>
          <ol>
            {sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>)}
          </ol>
        </section>
      )}
      {hasGa4 && <Ga4AiKanal />}
    </div>
  </article>

  {isEn ? (
    <Cta
      title="Need links that move rankings?"
      text="We build links and digital PR for agencies and in-house teams across the UK, US and EU. Tell us your site and we will send a free link gap audit."
      button="Get a free link gap audit"
      href="/en/contact/"
    />
  ) : (
    <Cta />
  )}
</Base>

<script define:vars={{ copyLabels: [t.copy, t.copied, t.copyFail] }}>
  // Gumb "Kopiraj" na svakom bloku koda u članku.
  document.querySelectorAll('.article pre').forEach((pre) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'copy-btn';
    b.textContent = copyLabels[0];
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        b.textContent = copyLabels[1];
      } catch {
        b.textContent = copyLabels[2];
      }
      setTimeout(() => (b.textContent = copyLabels[0]), 2000);
    });
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.replaceWith(wrap);
    wrap.append(b, pre);
  });
</script>

<style>
  .article { margin: 0 auto; }
  .article :global(.code-wrap) { position: relative; }
  .article :global(.copy-btn) { position: absolute; top: 10px; right: 10px; z-index: 1; border: 0; border-radius: 8px; padding: 6px 12px; background: var(--accent); color: #fff; font: 600 0.8rem var(--font); cursor: pointer; }
  .article h1 { font-size: clamp(2rem, 4.2vw, 3rem); }
  .crumbs { font-size: 0.9rem; margin-bottom: 12px; }
  .article__meta { font-size: 0.95rem; }
  .article__upd { font-weight: 600; color: var(--navy); }
  .article__faq details { border-bottom: 1px solid var(--border); padding: 14px 0; }
  .article__faq summary { cursor: pointer; font-weight: 600; color: var(--navy); }
  .article__faq details p { margin: 10px 0 0; color: var(--muted); }
  .article__sources ol { font-size: 0.9rem; }
  .article__sources a { word-break: break-word; }
  /* Interaktivni dodaci (kviz, tracker, mapa, dijagram) */
  .article :global(.wg) { margin: 2em 0; padding: clamp(18px, 3vw, 28px); border: 1px solid var(--border); border-radius: var(--radius); background: #fff; box-shadow: 0 10px 30px rgba(16, 43, 67, 0.06); }
  .article :global(.wg__eyebrow) { margin: 0 0 6px; color: var(--accent); font: 700 0.75rem var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; }
  .article :global(.wg__title) { margin: 0 0 6px; font-size: 1.35rem; }
  .article :global(.wg__lead) { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .article :global(.wg__note) { margin: 12px 0 0; color: var(--muted); font-size: 0.8rem; }
  .article__img { border-radius: 14px; margin: 24px 0 32px; width: 100%; height: auto; }
  .article :global(h3) { margin-top: 1.4em; }
  .article :global(ol), .article :global(ul) { padding-left: 1.3em; }
  .article :global(li) { margin-bottom: 0.4em; }
  .article :global(img) { border-radius: 10px; margin: 16px 0; height: auto; }
  .article :global(code) { background: var(--bg-2); padding: 2px 6px; border-radius: 6px; font-size: 0.9em; word-break: break-word; }
  .article :global(pre) { background: var(--navy) !important; color: #fff; padding: 16px 20px; border-radius: 12px; overflow-x: auto; }
  .article :global(pre code) { background: none; padding: 0; color: inherit; }
  .article :global(blockquote) { margin: 1.4em 0; padding: 4px 0 4px 18px; border-left: 3px solid var(--accent); color: var(--muted); }
  .article :global(table) { border-collapse: collapse; width: 100%; margin: 1.4em 0; font-size: 0.95rem; display: block; overflow-x: auto; }
  .article :global(th), .article :global(td) { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
  .article :global(th) { background: var(--bg-2); }
</style>
