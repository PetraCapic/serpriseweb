---
import Base from '../layouts/Base.astro';
---
<Base title="Stranica nije pronađena" description="Stranica koju tražite ne postoji." noindex>
  <section class="section">
    <div class="container" style="text-align:center;max-width:680px">
      <span class="eyebrow">404</span>
      <h1>Ova stranica nije u <span class="grad-text">rezultatima</span></h1>
      <p class="lead" style="margin:0 auto">Možda je premještena ili više ne postoji. Krenite s početne ili nam se javite.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/" class="btn btn--primary">Početna</a>
        <a href="/kontakt/" class="btn btn--ghost">Kontakt</a>
      </div>
    </div>
  </section>
</Base>
