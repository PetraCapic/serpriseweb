---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { getPosts, formatDate } from '../../lib/blog';

const posts = await getPosts();
---

<Base
  title="Blog o AI pretraživanju, LLM optimizaciji i SEO-u"
  description="Praktični vodiči o tome kako Google AI način, AI pregledi, ChatGPT i Gemini mijenjaju pretraživanje i što hrvatske tvrtke mogu napraviti."
  noindex={posts.length === 0}
>
  <PageHero
    eyebrow="Blog"
    title="AI pretraživanje, <span class='grad-text'>LLM optimizacija</span> i SEO"
    lead="Što se mijenja u Googleu, ChatGPT-u i Geminiju i kako to iskoristiti za vaš brend. Pišemo iz prakse, za hrvatsko tržište."
    cta={false}
  />
  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="muted">Prvi članci stižu uskoro.</p>
        ) : (
          <div class="grid grid--3">
            {posts.map((post) => (
              <a href={`/blog/${post.id}/`} class="card card--link post-card">
                {post.data.image && <img src={post.data.image} alt={post.data.imageAlt ?? ''} loading="lazy" />}
                <time class="muted" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <h2>{post.data.title}</h2>
                <p class="muted">{post.data.description}</p>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
  <Cta title="Želite znati što AI danas kaže o vama?" text="Besplatno ćemo testirati upite iz vaše branše u ChatGPT-u, Geminiju i Google AI pregledima." />
</Base>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .post-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--radius) - 6px);
  }
  .post-card h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .post-card time {
    font-size: 0.875rem;
  }
</style>
