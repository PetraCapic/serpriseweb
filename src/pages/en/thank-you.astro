---
import Base from '../../layouts/Base.astro';
---
<Base lang="en" title="Thank you" description="Your enquiry has been received." noindex>
  <section class="section">
    <div class="container" style="text-align:center;max-width:680px">
      <span class="eyebrow">Enquiry received</span>
      <h1>Thank you! <span class="grad-text">We'll be in touch soon.</span></h1>
      <p class="lead" style="margin:0 auto">Your message has reached us. We reply within one business day, often sooner.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/en/" class="btn btn--ghost">Back to home</a>
      </div>
    </div>
  </section>
</Base>
