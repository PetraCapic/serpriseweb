---
import Base from '../layouts/Base.astro';
---
<Base title="Hvala na upitu" description="Vaš upit je zaprimljen." noindex>
  <section class="section">
    <div class="container" style="text-align:center;max-width:680px">
      <span class="eyebrow">Upit zaprimljen</span>
      <h1>Hvala! <span class="grad-text">Javit ćemo se uskoro.</span></h1>
      <p class="lead" style="margin:0 auto">Vaš upit je stigao do nas. Odgovaramo unutar jednog radnog dana, a često i brže.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/" class="btn btn--ghost">Natrag na početnu</a>
      </div>
    </div>
  </section>
</Base>
