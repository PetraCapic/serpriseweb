---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../lib/site';
---

<Base
  title="Kontakt i besplatna analiza"
  description="Zatražite besplatnu analizu AI vidljivosti i profila poveznica. Javljamo se unutar jednog radnog dana."
>
  <PageHero
    eyebrow="Kontakt"
    title="Zatražite <span class='grad-text'>besplatnu analizu</span>"
    lead="Recite nam nešto o svom poslu. Javit ćemo se unutar jednog radnog dana s prvim zapažanjima o tome kako vas vide Google i AI asistenti."
    cta={false}
  />
  <section class="section">
    <div class="container contact">
      <ContactForm />
      <aside>
        <div class="card">
          <h3>Izravni kontakt</h3>
          <ul class="contact__list">
            <li><span class="muted">E-mail</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><span class="muted">Telefon</span><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
            <li><span class="muted">LinkedIn</span><a href={site.linkedin} target="_blank" rel="noopener">SERPRise</a></li>
          </ul>
        </div>
        <div class="card">
          <h3>Što slijedi nakon upita?</h3>
          <ul class="checklist">
            <li>Javljamo se unutar 1 radnog dana</li>
            <li>Kratki poziv (20 min) da razumijemo vaše ciljeve</li>
            <li>Besplatna analiza i prijedlog suradnje</li>
          </ul>
        </div>
        <p class="muted small">{site.legalName} · {site.address} · OIB {site.oib}</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start; }
  aside { display: grid; gap: 20px; }
  .contact__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .contact__list li { display: grid; }
  .contact__list span { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .small { font-size: 0.85rem; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>
