---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Clients from '../components/Clients.astro';
import Cta from '../components/Cta.astro';
import { team } from '../lib/site';
---

<Base
  title="O nama"
  description="SERPRise je hrvatska agencija specijalizirana za AI vidljivost (LLM optimizaciju), link building i digitalni PR. Mali tim, puno iskustva i fokus na hrvatsko tržište."
>
  <PageHero
    eyebrow="O nama"
    title="Mala agencija koja <span class='grad-text'>radi samo ono u čemu je najbolja</span>"
    lead="SERPRise je specijalizirana agencija iz Hrvatske. Godinama gradimo vidljivost brendovima u pretraživačima, a danas i u odgovorima AI asistenata."
    cta={false}
  />

  <section class="section">
    <div class="container grid grid--2 story">
      <div>
        <h2>Zašto smo se specijalizirali</h2>
        <p>
          Kroz godine rada na brojnim projektima naučili smo jedno: najveću razliku u rezultatima rade autoritet brenda i
          spomeni na pravim mjestima. To je danas važnije nego ikad, jer upravo na tim izvorima uče i AI asistenti.
        </p>
        <p>
          Zato smo se fokusirali na dvije stvari koje najbolje radimo: <a href="/ai-vidljivost/">AI vidljivost (LLM optimizaciju)</a>
          te <a href="/link-building-digitalni-pr/">link building i digitalni PR</a> na hrvatskom tržištu.
        </p>
      </div>
      <div class="card">
        <h3>Kako radimo</h3>
        <ul class="checklist">
          <li>Primamo ograničen broj novih klijenata mjesečno, da svaki dobije punu pažnju.</li>
          <li>Ne vežemo vas ugovorom. Ostajete jer vidite rezultate.</li>
          <li>Ne obećavamo nemoguće. Ako nešto nema smisla, reći ćemo vam.</li>
          <li>Rokove poštujemo. Uvijek.</li>
        </ul>
      </div>
    </div>
  </section>

  <Clients />

  <section class="section">
    <div class="container">
      <span class="eyebrow">Tim</span>
      <h2>Ljudi iza SERPRisea</h2>
      <div class="grid grid--3 team">
        {team.map((m) => (
          <article class="card member">
            {m.photo ? (
              <img src={m.photo} alt={m.name} width="96" height="96" loading="lazy" class="member__photo" />
            ) : (
              <div class="member__photo member__initials" aria-hidden="true">{m.name.split(' ').map((w) => w[0]).join('')}</div>
            )}
            <h3>{m.profile ? <a href={m.profile}>{m.name}</a> : m.name}</h3>
            <p class="eyebrow member__role">{m.role}</p>
            <p class="muted">{m.bio}</p>
            {m.linkedin && (
              <a href={m.linkedin} target="_blank" rel="noopener" class="member__in" aria-label={`${m.name} na LinkedInu`}>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
                LinkedIn
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .team { margin-top: 32px; }
  .member { display: flex; flex-direction: column; }
  /* Slika i inicijali su isti krug od 96px, kao na kontakt stranici */
  .member__photo { width: 96px; height: 96px; aspect-ratio: 1; object-fit: cover; object-position: top; border-radius: 50%; margin-bottom: 18px; background: var(--grad); }
  .member__initials { display: grid; place-items: center; font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: #fff; background: var(--grad); }
  .member h3 { margin: 0 0 4px; }
  .member__role { margin-bottom: 8px; }
  .member__in { margin-top: auto; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--navy); }
  .story {
    gap: 48px;
    align-items: start;
  }
</style>
